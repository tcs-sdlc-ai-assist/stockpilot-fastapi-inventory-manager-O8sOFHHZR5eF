# StockPilot Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# =============================================================================
# APPLICATION SECRET KEY
# =============================================================================
# Used for signing session tokens, CSRF protection, and other cryptographic ops.
# SECURITY WARNING: Generate a strong random key for production!
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key

# =============================================================================
# DEFAULT ADMIN CREDENTIALS
# =============================================================================
# These credentials are used to seed the initial admin user on first startup.
# SECURITY WARNING: Change these immediately after first login in production!
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-in-production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default for local development):
DATABASE_URL=sqlite+aiosqlite:///./stockpilot.db
#
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stockpilot
#
# SECURITY WARNING: Never embed production database credentials in this file.
# Use your hosting platform's environment variable management instead.